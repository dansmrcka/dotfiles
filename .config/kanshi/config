# Kanshi - nahrazuje daniel_set_monitor.sh, ~/.monitor.sh a arandr skripty.
# Profil se vybere sam podle toho, ktere vystupy jsou pripojene.
#
# Jmena a rezimy vystupu zjistis pres:  swaymsg -t get_outputs
# Rucni doladeni:                       wdisplays

profile standalone {
    output eDP-1 mode 1920x1200 position 0,0 scale 1
}

profile docked_hdmi {
    output eDP-1 mode 1920x1200 position 0,0 scale 1
    output HDMI-A-1 enable position 1920,0
}

profile docked_dp {
    output eDP-1 mode 1920x1200 position 0,0 scale 1
    output DP-1 enable position 1920,0
}

# Dock se dvema externimi DP monitory (MSI 4K + Dell FHD).
# Fyzicke rozlozeni zleva doprava: Dell - MSI 4K - laptop (eDP-1).
#
# Parovani je zamerne pres identitu "vyrobce model seriovka" (viz
# `swaymsg -t get_outputs`), ne pres jmeno portu (DP-5/DP-6/...). Jmeno
# portu se prideluje podle poradi detekce a po odpojeni/pripojeni docku
# se muze prehazet (uz se stalo vickrat), takze se profil netrefil a
# kanshi spadlo zpet na "standalone".
profile docked_dual_dp {
    output "Dell Inc. DELL P2422H 5QDPFZ3" mode 1920x1080 position 0,0 scale 1
    output "Microstep MSI MP273U PB4HE65702033" mode 3840x2160 position 1920,0 scale 1.5
    output eDP-1 mode 1920x1200 position 4480,0 scale 1
}

