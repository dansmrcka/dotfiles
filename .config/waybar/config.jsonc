// Waybar - nahrazuje i3blocks setup z i3 configu.
// Vetsina byvalych skriptu je tady vestavenym modulem; vlastni zustaly jen
// GPU, jazyk klavesnice a napajeci profil.
{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 2,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": [
        "custom/gpu",
        "cpu",
        "memory",
        "temperature",
        "disk",
        "network",
        "pulseaudio",
        "backlight",
        "custom/language",
        "custom/powerprofile",
        "battery",
        "tray",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "sway/mode": {
        // ukaze resize_mode / mouse_mode / gaps_mode
        "format": "<span style=\"italic\">{}</span>"
    },

    "sway/window": {
        "max-length": 60,
        "tooltip": false
    },

    "custom/language": {
        // Nahrazuje vestaveny "sway/language", ktery tu obcas misto jazyka
        // ukazoval prazdno. Duvod je v jeho zdrojaku (src/modules/sway/language.cpp):
        // set_current_layout() dela layouts_map_[jmeno], tedy std::map::operator[],
        // ktery pro neznamy klic tise vrati prazdny Layout. Mapa se navic plni
        // jen jednou pri startu, kdezto reaguje se na kazdou "input" udalost
        // z libovolneho zarizeni typu keyboard - a tech je tu 12 (Soundcore
        // AVRCP, Power/Sleep Button, Video Bus, HOLTEK dock...), pricemz se
        // za behu pridavaji a odebiraji. Volba keyboard-name je jen pro
        // hyprland/language, sway varianta ji nezna.
        //
        // Skript se misto toho ptá primo swaymsg a nikdy nevrati nic jineho
        // nez us/cz.
        "exec": "~/.config/waybar/scripts/language.sh",
        "return-type": "json",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },

    "cpu": {
        // ekvivalent byvaleho [load] bloku
        "interval": 5,
        "format": "󰘚  {load}",
        "tooltip": true
    },

    "memory": {
        "interval": 10,
        "format": "󰍛  {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "temperature": {
        "interval": 10,
        "critical-threshold": 85,
        "format": "󰸁  {temperatureC}°C",
        "format-critical": "󰸁  {temperatureC}°C"
    },

    "disk": {
        "interval": 30,
        "path": "/",
        "format": "󰋊  {percentage_used}%",
        "tooltip-format": "{used} / {total} na {path}"
    },

    "network": {
        // pokryva byvale [iface], [wifi], [bandwidth] i [online-status]
        "interval": 5,
        "format-wifi": "󰖩  {essid} {signalStrength}%",
        "format-ethernet": "󰈀  {ifname}",
        "format-linked": "󰠙  bez IP",
        "format-disconnected": "󰖪  odpojeno",
        "tooltip-format": "{ifname}  {ipaddr}\n {bandwidthDownBits}   {bandwidthUpBits}",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁  ztlumeno",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋌",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        // levy klik = plny mixer, pravy klik = rychla volba vystupu (stejne
        // menu jako $mod2+s v sway)
        "on-click": "pavucontrol",
        "on-click-right": "~/.scripts/audio_menu.sh",
        "scroll-step": 5
    },

    "backlight": {
        "format": "󰃝  {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "interval": 30,
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁽", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}  ({power}W)"
    },

    "custom/gpu": {
        // sam se vypne, kdyz NVIDIA spi (setri baterii)
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "return-type": "json",
        "interval": 10,
        "tooltip": true
    },

    "custom/powerprofile": {
        // Nahrazuje PowerDevil z Plasmy - ve sway napajeci profil nikdo nespravuje
        // a umi tise uviznout v powersave (vypnute turbo, CPU strop 1,4 GHz).
        // signal 8 = pkill -RTMIN+8 waybar, aby se po kliku prekreslilo hned.
        "exec": "~/.config/waybar/scripts/powerprofile.sh",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/powerprofile.sh set"
    },

    "tray": {
        // sem se vejde nm-applet i blueman-applet
        "icon-size": 14,
        "spacing": 6
    },

    "clock": {
        "interval": 1,
        "format": "󰥔  {:%d/%m/%Y %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
