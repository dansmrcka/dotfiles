# Sway config
# Portovano z ~/git/linux-setup/appconfig/i3/doti3/config_git (bez epigenu).
# Zkratky drzi puvodni i3 rozlozeni: $mod = Alt, $mod2 = Super.

### promenne ###

set $mod Mod1
set $mod2 Mod4

set $term kitty
set $scripts ~/.scripts

# Jednoradkovy pruh nahore ve stylu dmenu (wmenu + vlastni drun/run feeder).
# Barvy si bere z ~/.config/sway/colors, takze jde s theme.
set $menu $scripts/menu.sh

# integrace se systemd (balik sway-systemd):
# propaguje WAYLAND_DISPLAY/SWAYSOCK/XDG_CURRENT_DESKTOP do systemd a dbus,
# startuje sway-session.target -> graphical-session.target (a s nim portaly)
# a dava aplikacim vlastni systemd scope kvuli systemd-oomd.
# Bez tohohle radku xdg-desktop-portal nenabehne a sdileni obrazovky nefunguje.
include /etc/sway/config.d/*

# barvy + pozadi; symlink na colors.dark / colors.light, prepina set-theme.sh
include ~/.config/sway/colors

### vstupy ###

input type:keyboard {
    xkb_layout "us,cz"
    xkb_options "grp:alt_caps_toggle"
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
}

### vystupy ###
# jemnejsi nastaveni a externi monitory resi kanshi (~/.config/kanshi/config)

output eDP-1 mode 1920x1200 position 0,0 scale 1

### vzhled ###

# Terminus z puvodniho i3 configu neni nainstalovany, JetBrainsMono Nerd Font ano
font pango:JetBrainsMono Nerd Font 11

default_border pixel 3
default_floating_border pixel 3
hide_edge_borders both

smart_gaps on
set $default_gaps_inner 12
set $default_gaps_outer 0
gaps inner $default_gaps_inner
gaps outer $default_gaps_outer

focus_follows_mouse no
floating_modifier $mod normal

### zakladni zkratky ###

bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec $menu

# pozor: sway nema "restart", obe zkratky delaji reload
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r reload

### focus a presun oken ###

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym Mod1+Tab focus right

# presun workspace na druhy monitor
bindsym $mod+x move workspace to output right

# cyklovani workspacu na aktualnim monitoru
bindsym $mod+n workspace next_on_output
bindsym $mod+m workspace prev_on_output

### layout ###

bindsym $mod+braceright split h
bindsym $mod+braceleft split v

bindsym $mod+f fullscreen

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+a focus parent
bindsym $mod+q focus child

# schovat/ukazat waybar (v i3 to bylo "bar mode toggle")
bindsym $mod+b exec pkill -SIGUSR1 waybar

### workspacy ###
# ikony k cislum resi waybar (format-icons), aby se neplevelily nazvy

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

### scratchpad ###

bindsym $mod+Shift+z move scratchpad
bindsym $mod+z scratchpad show

### skripty a menu ###

# prepnuti tematu dark/light
bindsym $mod2+c exec $scripts/set-theme.sh

# system menu (lock, logout, suspend, reboot, shutdown)
bindsym $mod2+f exec $scripts/system_menu.sh
bindsym $mod+Shift+x exec $scripts/system_menu.sh

# screenshot vyrezu do schranky
bindsym Print exec grim -g "$(slurp)" - | wl-copy
# cela obrazovka do ~/Pictures
bindsym Shift+Print exec grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png

# historie schranky
bindsym $mod2+v exec cliphist list | $scripts/menu.sh --dmenu 'clip:' | cliphist decode | wl-copy

# F1 uz nespousti napovedu programu
bindsym F1 exec --no-startup-id true

### multimedialni klavesy ###

# --locked = funguje i na zamcene obrazovce (swaylock), jinak jsou hlasitost
# a jas pod zamkem mrtve.
# -n 1 u ztlumeni jasu: "set 7%-" umi dojet na nulu a uplne zhasnout panel.
# brightnessctl pise pres logind SetBrightness, takze root ani skupina video netreba.

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# jemne kroky po 1 % - v Plasme to bylo increase_volume_small / decrease_volume_small
bindsym --locked Shift+XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 1%+
bindsym --locked Shift+XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-

# mic mute na Meta - v Plasme mic_mute = Meta+Volume Mute
bindsym --locked $mod2+XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym --locked XF86MonBrightnessUp exec brightnessctl set 7%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 7%- -n 1
bindsym --locked Shift+XF86MonBrightnessUp exec brightnessctl set 1%+
bindsym --locked Shift+XF86MonBrightnessDown exec brightnessctl set 1%- -n 1

# podsviceni klavesnice (ThinkPad, rozsah 0-2)
bindsym --locked XF86KbdBrightnessUp exec brightnessctl -d 'tpacpi::kbd_backlight' set +1
bindsym --locked XF86KbdBrightnessDown exec brightnessctl -d 'tpacpi::kbd_backlight' set 1-

# kombinace prenesene z Plasmy (~/.config/kglobalshortcutsrc); $mod je Mod1 = Alt,
# takze Alt+F1/F2/F3 a Alt+F5/F6 sedi 1:1 na to, co jsi mel pod KDE
bindsym --locked $mod+F1 exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked $mod+F2 exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked $mod+F3 exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked $mod+F5 exec brightnessctl set 7%- -n 1
bindsym --locked $mod+F6 exec brightnessctl set 7%+

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

### rezimy ###

bindsym $mod+r mode "resize_mode"
bindsym $mod+c mode "mouse_mode"
bindsym $mod+Shift+g mode "gaps_mode"
bindsym $mod+Shift+t mode "throughput_mode"

# #{ resize_mode

mode "resize_mode" {
    # symetricky po 1 px
    bindsym h resize shrink left  1 px, resize shrink right 1 px
    bindsym j resize shrink down  1 px, resize shrink up    1 px
    bindsym k resize grow   up    1 px, resize grow   down  1 px
    bindsym l resize grow   right 1 px, resize grow   left  1 px

    # jednotliva hrana
    bindsym $mod+Shift+h resize shrink left 1 px
    bindsym Shift+h resize grow left 1 px
    bindsym $mod+Shift+j resize shrink down 1 px
    bindsym Shift+j resize grow down 1 px
    bindsym $mod+Shift+k resize shrink up 1 px
    bindsym Shift+k resize grow up 1 px
    bindsym $mod+Shift+l resize shrink right 1 px
    bindsym Shift+l resize grow right 1 px

    # sipky po 10 px
    bindsym Left  resize shrink left  10 px, resize shrink right 10 px
    bindsym Down  resize shrink down  10 px, resize shrink up    10 px
    bindsym Up    resize grow   up    10 px, resize grow   down  10 px
    bindsym Right resize grow   right 10 px, resize grow   left  10 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# #}

# #{ mouse_mode
# v i3 to jelo pres xdotool, sway umi kurzor nativne pres "seat"

mode "mouse_mode" {
    bindsym h seat - cursor move -10 0
    bindsym j seat - cursor move 0 10
    bindsym k seat - cursor move 0 -10
    bindsym l seat - cursor move 10 0

    bindsym Shift+h seat - cursor move -25 0
    bindsym Shift+j seat - cursor move 0 25
    bindsym Shift+k seat - cursor move 0 -25
    bindsym Shift+l seat - cursor move 25 0

    # focus i v rezimu
    bindsym $mod+h focus left
    bindsym $mod+j focus down
    bindsym $mod+k focus up
    bindsym $mod+l focus right

    bindsym $mod+n workspace next_on_output
    bindsym $mod+m workspace prev_on_output

    # kliky
    bindsym f seat - cursor press button1
    bindsym u seat - cursor press button1
    bindsym d seat - cursor press button3
    bindsym i seat - cursor press button3

    # odsun kurzoru do rohu aktivniho okna
    bindsym b exec $scripts/banish-mouse.sh

    # drzeny levy klik pro tazeni
    bindsym r seat - cursor press button1; mode "longpress_mode"

    bindsym Escape mode "default"
}

mode "longpress_mode" {
    bindsym h seat - cursor move -10 0
    bindsym j seat - cursor move 0 10
    bindsym k seat - cursor move 0 -10
    bindsym l seat - cursor move 10 0

    bindsym r seat - cursor release button1; mode "mouse_mode"
    bindsym Escape seat - cursor release button1; mode "default"
}

# #}

# #{ gaps_mode
# v puvodnim i3 configu byla zkratka navesena, ale samotny rezim chybel

mode "gaps_mode" {
    bindsym i gaps inner current plus 5
    bindsym Shift+i gaps inner current minus 5
    bindsym o gaps outer current plus 5
    bindsym Shift+o gaps outer current minus 5

    bindsym 0 gaps inner current set $default_gaps_inner; gaps outer current set $default_gaps_outer

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# #}

# #{ throughput_mode
# spolkne zkratky, aby slo ovladat vzdalenou plochu / tmux uvnitr

mode "throughput_mode" {
    bindsym $mod+Shift+t mode "default"
}

# #}

### pravidla oken ###
# class= plati jen pro Xwayland, app_id= pro nativni Wayland aplikace
# skutecne hodnoty zjistis pres: swaymsg -t get_tree

for_window [class="^Thunar$"] floating disable
for_window [app_id="^thunar$"] floating disable
for_window [class="^Tk$"] floating enable
for_window [class="^Octave-gui$"] floating enable
for_window [class="^Google-chrome$"] floating disable
for_window [class="matplotlib"] floating enable
for_window [title="^Figure"] floating disable
for_window [title="pdfpc"] border none floating disable
for_window [title="pythonplot"] floating disable

# mail ma svou vlastni plochu - Betterbird startuje z ~/.config/autostart,
# takze se tam odklidi sam a nevlezne do cesty na plose, kde zrovna delas.
assign [app_id="^eu\.betterbird\.Betterbird$"] workspace number 9

# ovladaci dialogy at plavou
for_window [window_role="pop-up|bubble|dialog"] floating enable
for_window [app_id="^pavucontrol$"] floating enable
for_window [app_id="^wdisplays$"] floating enable
for_window [app_id="^blueman-manager$"] floating enable

### autostart ###

exec waybar
exec mako
exec kanshi
exec nm-applet --indicator
exec blueman-applet
exec /usr/libexec/kf6/polkit-kde-authentication-agent-1
exec wl-paste --watch cliphist store

# na jednom radku zamerne - vyhybame se pokracovani radku v sway configu
exec swayidle -w timeout 300 'swaylock -f -c 000000' timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep 'swaylock -f -c 000000'

# zpracovani ~/.config/autostart (Betterbird, Syncthing).
# Ceka na tray, proto az za "exec waybar" - waybar tray je jeho implementace.
include /usr/share/sway-systemd/95-xdg-desktop-autostart.conf
